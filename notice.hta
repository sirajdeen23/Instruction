<html>
<head>
<title>System Notification</title>

<!-- The HTA:APPLICATION tag is what turns this from a standard webpage into a Windows application -->
<HTA:APPLICATION 
    ID="objWelcome" 
    APPLICATIONNAME="LogonPopup" 
    SCROLL="no" 
    SINGLEINSTANCE="yes" 
    WINDOWSTATE="normal"
    NAVIGABLE="no"
    SHOWINTASKBAR="yes"
    SYSMENU="no"
    BORDER="dialog">

<script>
    // Set the window size (Width, Height)
    var windowWidth = 550;
    var windowHeight = 350;
    window.resizeTo(windowWidth, windowHeight);

    // Calculate the center of the screen and move the popup there
    var xPos = (screen.width - windowWidth) / 2;
    var yPos = (screen.height - windowHeight) / 2;
    window.moveTo(xPos, yPos);
</script>

<style>
    body { 
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
        background-color: #f3f3f3; 
        color: #333;
        padding: 0; 
        margin: 0;
        text-align: center; 
        border: 2px solid #0078D7;
    }
    .header {
        background-color: #0078D7;
        color: white;
        padding: 15px;
        font-size: 20px;
        font-weight: bold;
    }
    .content { 
        padding: 30px 40px; 
        font-size: 15px; 
        line-height: 1.6; 
    }
    button { 
        padding: 10px 30px; 
        background-color: #0078D7; 
        color: white; 
        border: none; 
        font-size: 14px;
        cursor: pointer; 
        margin-top: 10px;
    }
    button:hover { 
        background-color: #005a9e; 
    }
</style>
</head>
<body>
    
    <div class="header">
        Daily Announcement
    </div>

    <div class="content">
        <p>Welcome to the network.</p>
        <p>This message is being pulled live from your GitHub repository. You can update this text in GitHub, and it will change here on the next logon without touching the local PC.</p>
        
        <button onclick="window.close()">I Understand</button>
    </div>

</body>
</html>
