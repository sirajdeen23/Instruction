<html>
<head>
<title>Apollo Notification</title>

<!-- This meta tag forces Windows to use modern scaling, fixing the shrink issue -->
<meta http-equiv="x-ua-compatible" content="ie=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<HTA:APPLICATION 
    ID="objWelcome" 
    APPLICATIONNAME="ApolloKnowledge_Info" 
    SCROLL="no" 
    SINGLEINSTANCE="yes" 
    WINDOWSTATE="normal"
    NAVIGABLE="no"
    SHOWINTASKBAR="yes"
    SYSMENU="no"
    BORDER="dialog">

<script>
    // Increased the base window size for modern screens
    var windowWidth = 650;
    var windowHeight = 450;
    window.resizeTo(windowWidth, windowHeight);

    // Calculate the center of the screen and move the popup there
    var xPos = (screen.width - windowWidth) / 2;
    var yPos = (screen.height - windowHeight) / 2;
    window.moveTo(xPos, yPos);
</script>

<style>
    body { 
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
        background-color: #f3f3f3; 
        color: #333;
        padding: 0; 
        margin: 0;
        text-align: center; 
        border: 2px solid #0078D7;
    }
    .header {
        background-color: #0078D7;
        color: white;
        padding: 15px;
        font-size: 24px;
        font-weight: bold;
    }
    .content { 
        padding: 30px 40px; 
        font-size: 18px; 
        line-height: 1.6; 
    }
    button { 
        padding: 12px 35px; 
        background-color: #0078D7; 
        color: white; 
        border: none; 
        font-size: 16px;
        cursor: pointer; 
        margin-top: 15px;
    }
    button:hover { 
        background-color: #005a9e; 
    }
</style>
</head>
<body>
    
    <div class="header">
        Daily Announcement
    </div>

    <div class="content">
        <p>Welcome to the network.</p>
        <p>This message is being pulled live from your GitHub repository. You can update this text in GitHub, and it will change here on the next logon without touching the local PC.</p>
        
        <button onclick="window.close()">I Understand</button>
    </div>

</body>
</html>
